# Required.
ANTHROPIC_API_KEY=replace_with_your_key
PERPLEXITY_API_KEY=replace_with_your_key
DATA_PATH=/absolute/path/to/research_workspace

# Optional, for the economics Census agent.
# CENSUS_API_KEY=replace_with_your_key
# IPUMS_API_KEY=replace_with_your_key

# Optional: path to a specific Claude executable. By default the executable
# bundled with the Claude Agent SDK is used.
# CLAUDE_CODE_CLI_PATH=/absolute/path/to/claude
